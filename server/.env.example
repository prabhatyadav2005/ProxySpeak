# ProxySpeak Signaling & Spatial Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional MongoDB connection (falls back to in-memory store if offline)
MONGO_URI=mongodb://127.0.0.1:27017/proxyspeak

# Optional Redis cluster scaling (falls back to local memory if offline)
USE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

